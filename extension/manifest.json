{
  "manifest_version": 3,
  "name": "WireRoute",
  "short_name": "WireRoute",
  "version": "1.3.6",
  "description": "Send each website through the WireGuard server you pick. Hidden addresses a site uses follow it automatically.",
  "key": "",
  "minimum_chrome_version": "120",

  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "webRequest",
    "declarativeNetRequest",
    "privacy",
    "alarms",
    "favicon",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WireRoute",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
